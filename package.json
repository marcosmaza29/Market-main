{
  "name": "market-frontend",
  "private": true,
  "description": "Estilos (Tailwind CSS) e iconos de la interfaz de Market",
  "scripts": {
    "build:css": "tailwindcss -i src/main/frontend/app.css -o src/main/webapp/assets/app.css --minify",
    "watch:css": "tailwindcss -i src/main/frontend/app.css -o src/main/webapp/assets/app.css --watch",
    "iconos": "sh tools/descargar-iconos.sh"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3"
  }
}
