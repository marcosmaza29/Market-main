<%-- Pantallas de acceso (centradas). Requiere: String titulo, String subtitulo --%>
<body class="min-h-dvh">
<a href="#contenido" class="enlace-salto">Saltar al contenido</a>
<div class="flex min-h-dvh flex-col">
    <header class="contenedor flex h-16 items-center justify-between">
        <a href="<%= ctx %>/jsp-Interfaz/interfaz.jsp?tienda=<%= contextoTienda %>" class="flex items-center gap-2.5 rounded-lg">
            <span class="grid size-9 place-items-center rounded-lg bg-marca-700 text-white"><ui:icono n="storefront"/></span>
            <span class="text-[15px] font-semibold text-stone-900"><%= util.Html.esc(util.Tienda.nombre(contextoTienda)) %></span>
        </a>
        <a href="<%= ctx %>/jsp-Interfaz/interfaz.jsp?tienda=<%= contextoTienda %>" class="btn btn-fantasma btn-sm"><ui:icono n="arrow_back" clase="size-4"/>Volver a la tienda</a>
    </header>
    <main id="contenido" class="flex flex-1 items-start justify-center px-4 pt-6 pb-16 sm:items-center sm:pt-0">
        <div class="w-full max-w-md">
            <div class="mb-6 text-center">
                <h1 class="text-2xl font-semibold tracking-tight text-stone-900"><%= util.Html.esc(titulo) %></h1>
                <p class="mt-2 text-sm text-stone-600"><%= subtitulo %></p>
            </div>
            <div class="tarjeta tarjeta-cuerpo">
