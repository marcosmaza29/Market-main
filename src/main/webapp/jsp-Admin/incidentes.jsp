<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" import="java.sql.*,java.util.*,util.Html,util.Tienda" %>
<%@ include file="/WEB-INF/jspf/comun.jspf" %>
<%
 String tiendaId=(String)session.getAttribute("adminTiendaId");
 if(!Boolean.TRUE.equals(session.getAttribute("adminLogueado")) || !Tienda.valida(tiendaId) || !tiendaId.equals(contextoTienda)){response.sendError(403);return;}
 String titulo="Gestor de incidentes",seccion="incidentes";
 String usuario=(String)session.getAttribute("adminUsuario");if(usuario==null||usuario.trim().isEmpty())usuario="Administrador";
 String csrf=(String)session.getAttribute("csrfIncidentes");if(csrf==null){csrf=UUID.randomUUID().toString();session.setAttribute("csrfIncidentes",csrf);}
 String[] cats={"aplicacion","rendimiento","base_datos","seguridad","red","otros"};
 String[] estados={"registrado","asignado","en_proceso","escalado","resuelto","cerrado"};
 String[] prioridades={"P1","P2","P3","P4"};
 String error=null;
 if("POST".equalsIgnoreCase(request.getMethod())){
   if(!csrf.equals(request.getParameter("csrf"))){response.sendError(403);return;}
   String accion=Html.param(request,"accion");
   try(Connection con=util.Conexion.getConnection()){
     con.setAutoCommit(false);
     try{
       if("crear".equals(accion)){
         String nombre=Html.param(request,"titulo"),detalle=Html.param(request,"descripcion"),cat=Html.param(request,"categoria"),prior=Html.param(request,"prioridad"),asignado=Html.param(request,"responsable"),herr=Html.param(request,"herramientas");
         if(nombre==null||nombre.length()<4||nombre.length()>160||detalle==null||detalle.isEmpty()||detalle.length()>5000||!Arrays.asList(cats).contains(cat)||!Arrays.asList(prioridades).contains(prior)||asignado==null||asignado.length()>120||herr==null||herr.length()>300)throw new IllegalArgumentException("Revisa el título, descripción, categoría, prioridad y límites de caracteres.");
         int hr="P1".equals(prior)?1:"P2".equals(prior)?4:"P3".equals(prior)?8:24;
         int hs="P1".equals(prior)?4:"P2".equals(prior)?12:"P3".equals(prior)?48:120;
         String estado=asignado.isEmpty()?"registrado":"asignado";
         long id;
         try(PreparedStatement ps=con.prepareStatement("INSERT INTO incidentes (tienda_id,titulo,descripcion,categoria,prioridad,estado,reportado_por,responsable,herramientas,respuesta_horas,solucion_horas,limite_respuesta,limite_solucion) VALUES (?,?,?,?,?,?,?,?,?,?,?,NOW()+(? * INTERVAL '1 hour'),NOW()+(? * INTERVAL '1 hour')) RETURNING id")){
           int n=1;ps.setString(n++,tiendaId);ps.setString(n++,nombre);ps.setString(n++,detalle);ps.setString(n++,cat);ps.setString(n++,prior);ps.setString(n++,estado);ps.setString(n++,usuario);ps.setString(n++,asignado);ps.setString(n++,herr);ps.setInt(n++,hr);ps.setInt(n++,hs);ps.setInt(n++,hr);ps.setInt(n++,hs);
           try(ResultSet rs=ps.executeQuery()){if(!rs.next())throw new SQLException("No se generó identificador");id=rs.getLong(1);}
         }
         try(PreparedStatement ps=con.prepareStatement("INSERT INTO incidentes_historial(incidente_id,tienda_id,accion,actor,estado_nuevo,responsable,comentario) VALUES(?,?,?,?,?,?,?)")){
           ps.setLong(1,id);ps.setString(2,tiendaId);ps.setString(3,"registro");ps.setString(4,usuario);ps.setString(5,estado);ps.setString(6,asignado);ps.setString(7,"Incidente registrado");ps.executeUpdate();
         }
       }else if("actualizar".equals(accion)){
         String idRaw=Html.param(request,"id"),nuevo=Html.param(request,"estado"),responsable=Html.param(request,"responsable"),nota=Html.param(request,"nota"),herr=Html.param(request,"herramientas");
         if(idRaw==null||!idRaw.matches("[0-9]{1,18}")||!Arrays.asList(estados).contains(nuevo)||responsable==null||responsable.length()>120||nota==null||nota.length()>2000||herr==null||herr.length()>300)throw new IllegalArgumentException("Datos de actualización inválidos.");
         long id=Long.parseLong(idRaw);String anterior;int escalamiento;boolean cerrado=false;
         try(PreparedStatement ps=con.prepareStatement("SELECT estado,nivel_escalamiento FROM incidentes WHERE id=? AND tienda_id=? FOR UPDATE")){
           ps.setLong(1,id);ps.setString(2,tiendaId);try(ResultSet rs=ps.executeQuery()){if(!rs.next())throw new IllegalArgumentException("Incidente no encontrado en esta tienda.");anterior=rs.getString(1);escalamiento=rs.getInt(2);}
         }
         if("cerrado".equals(anterior))throw new IllegalArgumentException("El incidente ya fue cerrado. No se puede editar.");
         if(("asignado".equals(nuevo)||"en_proceso".equals(nuevo)||"escalado".equals(nuevo))&&responsable.trim().isEmpty())throw new IllegalArgumentException("Indica un responsable antes de asignar o escalar.");
         if("cerrado".equals(nuevo)&&!"resuelto".equals(anterior))throw new IllegalArgumentException("Primero marca el incidente como resuelto; después podrás cerrarlo.");
         if("registrado".equals(nuevo)&&!"registrado".equals(anterior))throw new IllegalArgumentException("No se puede retroceder a registrado.");
         if("escalado".equals(nuevo) && escalamiento>=5)throw new IllegalArgumentException("Se alcanzó el nivel máximo de escalamiento (5).");
         if(("resuelto".equals(nuevo)||"cerrado".equals(nuevo))&&nota.trim().isEmpty())throw new IllegalArgumentException("Debes documentar la solución antes de resolver o cerrar.");
         if("resuelto".equals(anterior)&&!"resuelto".equals(nuevo)&&!"cerrado".equals(nuevo))throw new IllegalArgumentException("Un incidente resuelto solo puede permanecer resuelto o cerrarse.");
         boolean escalar="escalado".equals(nuevo)&&!"escalado".equals(anterior);
         try(PreparedStatement ps=con.prepareStatement("UPDATE incidentes SET estado=?,responsable=?,herramientas=?,nivel_escalamiento=nivel_escalamiento+?,primera_respuesta_en=CASE WHEN primera_respuesta_en IS NULL AND (? <> 'registrado' OR ? <> '') THEN NOW() ELSE primera_respuesta_en END,resuelto_en=CASE WHEN ?='resuelto' AND resuelto_en IS NULL THEN NOW() ELSE resuelto_en END,cerrado_en=CASE WHEN ?='cerrado' THEN NOW() ELSE cerrado_en END,actualizado_en=NOW() WHERE id=? AND tienda_id=?")){
           int n=1;ps.setString(n++,nuevo);ps.setString(n++,responsable);ps.setString(n++,herr);ps.setInt(n++,escalar?1:0);ps.setString(n++,nuevo);ps.setString(n++,nota);ps.setString(n++,nuevo);ps.setString(n++,nuevo);ps.setLong(n++,id);ps.setString(n++,tiendaId);if(ps.executeUpdate()!=1)throw new SQLException("No se pudo actualizar el incidente.");
         }
         try(PreparedStatement ps=con.prepareStatement("INSERT INTO incidentes_historial(incidente_id,tienda_id,accion,actor,estado_anterior,estado_nuevo,responsable,comentario) VALUES(?,?,?,?,?,?,?,?)")){
           ps.setLong(1,id);ps.setString(2,tiendaId);ps.setString(3,escalar?"escalamiento":"actualizacion");ps.setString(4,usuario);ps.setString(5,anterior);ps.setString(6,nuevo);ps.setString(7,responsable);ps.setString(8,nota);ps.executeUpdate();
         }
       }else throw new IllegalArgumentException("Acción no válida.");
       con.commit();response.sendRedirect(ctx+"/jsp-Admin/incidentes.jsp?tienda="+tiendaId+"&ok=1");return;
     }catch(Exception e){con.rollback();throw e;}
   }catch(IllegalArgumentException e){error=e.getMessage();}
   catch(Exception e){log("Error guardando incidente",e);error="No se pudo guardar. Comprueba la migración 09 y la conexión a la base de datos.";}
 }
 String filtro=Html.param(request,"estadoFiltro"),fPrior=Html.param(request,"prioridadFiltro");
 if(filtro!=null&&!Arrays.asList(estados).contains(filtro))filtro=null;
 if(fPrior!=null&&!Arrays.asList(prioridades).contains(fPrior))fPrior=null;
 List<Map<String,String>> incidentes=new ArrayList<>();List<Map<String,String>> historial=new ArrayList<>();int total=0,abiertos=0,vencidos=0;
 try(Connection con=util.Conexion.getConnection()){
   try(PreparedStatement ps=con.prepareStatement("SELECT COUNT(*),COUNT(*) FILTER(WHERE estado NOT IN ('resuelto','cerrado')),COUNT(*) FILTER(WHERE estado NOT IN ('resuelto','cerrado') AND NOW()>limite_solucion) FROM incidentes WHERE tienda_id=?")){
     ps.setString(1,tiendaId);try(ResultSet rs=ps.executeQuery()){if(rs.next()){total=rs.getInt(1);abiertos=rs.getInt(2);vencidos=rs.getInt(3);}}
   }
   String sql="SELECT id,titulo,descripcion,categoria,prioridad,estado,reportado_por,responsable,herramientas,nivel_escalamiento,respuesta_horas,solucion_horas,creado_en::text,limite_respuesta::text,limite_solucion::text,primera_respuesta_en::text,resuelto_en::text, (CASE WHEN primera_respuesta_en IS NULL THEN NOW()>limite_respuesta ELSE primera_respuesta_en>limite_respuesta END) AS sla_respuesta_vencido, (CASE WHEN resuelto_en IS NULL THEN NOW()>limite_solucion ELSE resuelto_en>limite_solucion END) AS sla_solucion_vencido FROM incidentes WHERE tienda_id=?"+(filtro==null?"":" AND estado=?")+(fPrior==null?"":" AND prioridad=?")+" ORDER BY CASE prioridad WHEN 'P1' THEN 1 WHEN 'P2' THEN 2 WHEN 'P3' THEN 3 ELSE 4 END,creado_en DESC LIMIT 100";
   try(PreparedStatement ps=con.prepareStatement(sql)){
     int n=1;ps.setString(n++,tiendaId);if(filtro!=null)ps.setString(n++,filtro);if(fPrior!=null)ps.setString(n++,fPrior);
     try(ResultSet rs=ps.executeQuery()){while(rs.next()){Map<String,String> fila=new HashMap<>();for(String k:new String[]{"id","titulo","descripcion","categoria","prioridad","estado","reportado_por","responsable","herramientas","nivel_escalamiento","respuesta_horas","solucion_horas","creado_en","limite_respuesta","limite_solucion","primera_respuesta_en","resuelto_en","sla_respuesta_vencido","sla_solucion_vencido"})fila.put(k,rs.getString(k));incidentes.add(fila);}}
   }
   try(PreparedStatement ps=con.prepareStatement("SELECT h.incidente_id::text,h.accion,h.actor,h.estado_anterior,h.estado_nuevo,h.responsable,h.comentario,h.creado_en::text FROM incidentes_historial h INNER JOIN incidentes i ON i.id=h.incidente_id AND i.tienda_id=h.tienda_id WHERE h.tienda_id=? ORDER BY h.creado_en DESC LIMIT 25")){
     ps.setString(1,tiendaId);try(ResultSet rs=ps.executeQuery()){while(rs.next()){Map<String,String> fila=new HashMap<>();for(String k:new String[]{"incidente_id","accion","actor","estado_anterior","estado_nuevo","responsable","comentario","creado_en"})fila.put(k,rs.getString(k));historial.add(fila);}}
   }
 }catch(Exception e){log("Error consultando incidentes",e);error="No se pudieron consultar los incidentes. Ejecuta db/09_incidentes.sql en Supabase y verifica permisos JDBC.";}
%>
<!DOCTYPE html><html lang="es"><head><%@ include file="/WEB-INF/jspf/head.jspf" %></head>
<%@ include file="/WEB-INF/jspf/admin-inicio.jspf" %>
<div class="flex flex-wrap items-start justify-between gap-3"><div><h1 class="text-2xl font-semibold">Gestor de incidentes</h1><p class="mt-2 text-sm text-stone-600">Registro, asignación, escalamiento, atención y SLA de <%= Html.esc(Tienda.nombre(tiendaId)) %>.</p></div><span class="etiqueta"><%= Html.esc(Tienda.nombre(tiendaId)) %></span></div>
<% if(error!=null){ %><div role="alert" class="tarjeta mt-4 border-red-300 bg-red-50 p-4 text-sm"><%= Html.esc(error) %></div><% } %>
<% if("1".equals(request.getParameter("ok"))){ %><div role="status" class="tarjeta mt-4 border-emerald-300 bg-emerald-50 p-4 text-sm">El incidente se guardó correctamente.</div><% } %>
<div class="mt-5 grid gap-3 sm:grid-cols-3"><div class="tarjeta p-4"><p class="text-sm text-stone-600">Incidentes totales</p><p class="text-2xl font-semibold"><%= total %></p></div><div class="tarjeta p-4"><p class="text-sm text-stone-600">Abiertos</p><p class="text-2xl font-semibold"><%= abiertos %></p></div><div class="tarjeta p-4"><p class="text-sm text-stone-600">SLA de solución vencidos</p><p class="text-2xl font-semibold"><%= vencidos %></p></div></div>
<section class="tarjeta mt-5 p-5"><h2 class="text-lg font-semibold">Registrar incidente</h2><p class="mt-1 text-sm text-stone-600">Los plazos SLA se generan al registrar el incidente. Se calculan en horas corridas (24/7), no en horas laborales.</p>
<form method="post" action="<%= ctx %>/jsp-Admin/incidentes.jsp?tienda=<%= Html.esc(tiendaId) %>" class="mt-4 grid gap-3 md:grid-cols-2"><input type="hidden" name="csrf" value="<%= Html.esc(csrf) %>"><input type="hidden" name="accion" value="crear">
<div class="md:col-span-2"><label class="mb-1 block text-sm font-medium" for="i-titulo">Título</label><input class="entrada w-full" id="i-titulo" name="titulo" maxlength="160" minlength="4" required placeholder="Ej. Lentitud en el registro de pedidos"></div>
<div class="md:col-span-2"><label class="mb-1 block text-sm font-medium" for="i-descripcion">Descripción del incidente e impacto</label><textarea class="entrada w-full" id="i-descripcion" name="descripcion" maxlength="5000" rows="3" required></textarea></div>
<div><label class="mb-1 block text-sm font-medium" for="i-categoria">Categoría</label><select class="entrada w-full" id="i-categoria" name="categoria"><option value="aplicacion">Aplicación</option><option value="rendimiento">Rendimiento</option><option value="base_datos">Base de datos</option><option value="seguridad">Seguridad</option><option value="red">Red / conectividad</option><option value="otros">Otros</option></select></div>
<div><label class="mb-1 block text-sm font-medium" for="i-prioridad">Prioridad</label><select class="entrada w-full" id="i-prioridad" name="prioridad"><option value="P1">P1 · Crítica (respuesta 1h / solución 4h)</option><option value="P2">P2 · Alta (4h / 12h)</option><option value="P3" selected>P3 · Media (8h / 48h)</option><option value="P4">P4 · Baja (24h / 120h)</option></select></div>
<div><label class="mb-1 block text-sm font-medium" for="i-responsable">Responsable asignado (opcional)</label><input class="entrada w-full" id="i-responsable" name="responsable" maxlength="120" placeholder="Nombre del técnico o encargado"></div>
<div><label class="mb-1 block text-sm font-medium" for="i-herramientas">Herramientas utilizadas</label><input class="entrada w-full" id="i-herramientas" name="herramientas" maxlength="300" value="Market, Prometheus, Grafana"></div>
<div class="md:col-span-2"><button class="btn btn-primario" type="submit">Registrar incidente</button></div></form></section>
<section class="tarjeta mt-5 p-5" aria-label="Monitoreo integrado"><div class="flex flex-wrap items-center justify-between gap-3"><div><h2 class="text-lg font-semibold">Monitoreo del servicio</h2><p class="mt-1 text-sm text-stone-600">Métricas de actividad de esta tienda. RAM, CPU y disco corresponden al servidor compartido.</p></div><a class="btn btn-secundario" href="<%= ctx %>/jsp-Admin/planCapacidad.jsp?tienda=<%= Html.esc(tiendaId) %>">Abrir gestor de rendimiento</a></div>
<div class="mt-4 grid gap-3 sm:grid-cols-4"><div><p class="text-sm text-stone-600">Solicitudes HTTP</p><strong id="inc-requests">—</strong></div><div><p class="text-sm text-stone-600">Errores HTTP 5xx</p><strong id="inc-errores">—</strong></div><div><p class="text-sm text-stone-600">Tiempo medio</p><strong id="inc-tiempo">—</strong></div><div><p class="text-sm text-stone-600">Estado</p><strong id="inc-monitor-status" role="status">Conectando</strong></div></div>
<p class="mt-3 text-xs text-stone-600">Tecnologías integradas: Java/Tomcat, Prometheus y Grafana. ITSM basado en el flujo de gestión de incidentes; no se configura conexión real con ServiceNow, Jira Service Management, GLPI, iTop, Freshservice, ManageEngine SDP, Zabbix o Azure Monitor.</p></section>
<section class="mt-7"><div class="flex flex-wrap items-end justify-between gap-3"><div><h2 class="text-lg font-semibold">Bandeja de incidentes</h2><p class="text-sm text-stone-600">Hasta 100 incidentes. Datos visibles solo para esta tienda.</p></div><form method="get" class="flex flex-wrap items-end gap-2"><input type="hidden" name="tienda" value="<%= Html.esc(tiendaId) %>"><div><label class="block text-xs" for="f-estado">Estado</label><select class="entrada" id="f-estado" name="estadoFiltro"><option value="">Todos</option><% for(String e:estados){ %><option value="<%= e %>" <%= e.equals(filtro)?"selected":"" %>><%= e.replace('_',' ') %></option><% } %></select></div><div><label class="block text-xs" for="f-prioridad">Prioridad</label><select class="entrada" id="f-prioridad" name="prioridadFiltro"><option value="">Todas</option><% for(String p:prioridades){ %><option value="<%= p %>" <%= p.equals(fPrior)?"selected":"" %>><%= p %></option><% } %></select></div><button class="btn btn-secundario" type="submit">Filtrar</button></form></div>
<% if(incidentes.isEmpty()){ %><p class="tarjeta mt-4 p-5 text-sm text-stone-600">No hay incidentes para estos filtros.</p><% } %>
<div class="mt-4 space-y-4"><% for(Map<String,String> i:incidentes){boolean cerrado="cerrado".equals(i.get("estado")); %>
<article class="tarjeta p-5"><div class="flex flex-wrap items-start justify-between gap-3"><div><p class="text-xs text-stone-600">INC-<%= Html.esc(i.get("id")) %> · <%= Html.esc(i.get("creado_en")) %> · <%= Html.esc(i.get("categoria")) %></p><h3 class="mt-1 text-lg font-semibold"><%= Html.esc(i.get("titulo")) %></h3><p class="text-sm text-stone-600">Reportado por: <%= Html.esc(i.get("reportado_por")) %></p></div><div class="flex gap-2"><span class="etiqueta"><%= Html.esc(i.get("prioridad")) %></span><span class="etiqueta"><%= Html.esc(i.get("estado").replace('_',' ')) %></span></div></div>
<p class="mt-3 whitespace-pre-wrap break-words text-sm"><%= Html.esc(i.get("descripcion")) %></p>
<div class="mt-3 grid gap-2 text-sm sm:grid-cols-2"><p><strong>Responsable:</strong> <%= Html.esc(i.get("responsable").isEmpty()?"Sin asignar":i.get("responsable")) %></p><p><strong>Escalamiento:</strong> nivel <%= Html.esc(i.get("nivel_escalamiento")) %></p><p><strong>Primera respuesta:</strong> <%= Html.esc(i.get("respuesta_horas")) %> h · <%= Html.esc(i.get("limite_respuesta")) %> <strong><%= "true".equals(i.get("sla_respuesta_vencido"))?"(SLA incumplido)":"(En plazo)" %></strong></p><p><strong>Solución:</strong> <%= Html.esc(i.get("solucion_horas")) %> h · <%= Html.esc(i.get("limite_solucion")) %> <strong><%= "true".equals(i.get("sla_solucion_vencido"))?"(SLA incumplido)":"(En plazo)" %></strong></p><p><strong>Primera atención:</strong> <%= Html.esc(i.get("primera_respuesta_en")==null?"Pendiente":i.get("primera_respuesta_en")) %></p><p><strong>Resuelto:</strong> <%= Html.esc(i.get("resuelto_en")==null?"Pendiente":i.get("resuelto_en")) %></p></div>
<% if(!cerrado){ %><form method="post" action="<%= ctx %>/jsp-Admin/incidentes.jsp?tienda=<%= Html.esc(tiendaId) %>" class="mt-4 grid gap-3 border-t border-stone-200 pt-4 sm:grid-cols-2"><input type="hidden" name="csrf" value="<%= Html.esc(csrf) %>"><input type="hidden" name="accion" value="actualizar"><input type="hidden" name="id" value="<%= Html.esc(i.get("id")) %>"><div><label class="mb-1 block text-sm font-medium" for="estado-<%= i.get("id") %>">Flujo de atención</label><select class="entrada w-full" name="estado" id="estado-<%= i.get("id") %>"><% for(String e:estados){ %><option value="<%= e %>" <%= e.equals(i.get("estado"))?"selected":"" %>><%= e.replace('_',' ') %></option><% } %></select></div><div><label class="mb-1 block text-sm font-medium" for="responsable-<%= i.get("id") %>">Responsable</label><input class="entrada w-full" id="responsable-<%= i.get("id") %>" name="responsable" maxlength="120" value="<%= Html.esc(i.get("responsable")) %>"></div><div class="sm:col-span-2"><label class="mb-1 block text-sm font-medium" for="herr-<%= i.get("id") %>">Herramientas utilizadas</label><input class="entrada w-full" name="herramientas" id="herr-<%= i.get("id") %>" maxlength="300" value="<%= Html.esc(i.get("herramientas")) %>"></div><div class="sm:col-span-2"><label class="mb-1 block text-sm font-medium" for="nota-<%= i.get("id") %>">Nota / evidencia de atención o solución</label><textarea class="entrada w-full" rows="2" id="nota-<%= i.get("id") %>" name="nota" maxlength="2000" placeholder="Describe la actividad, diagnóstico, evidencia o solución"></textarea></div><div class="sm:col-span-2"><button class="btn btn-primario" type="submit">Guardar seguimiento</button></div></form><% }else{ %><p class="mt-4 text-sm text-stone-600">Incidente cerrado: solo lectura.</p><% } %></article><% } %></div></section>
<section class="mt-7"><h2 class="text-lg font-semibold">Historial de atención</h2><p class="text-sm text-stone-600">Últimos 25 eventos de esta tienda: quién actuó, a quién asignó y qué cambió.</p><div class="mt-3 space-y-2"><% for(Map<String,String> h:historial){ %><div class="tarjeta p-3 text-sm"><p><strong>INC-<%= Html.esc(h.get("incidente_id")) %> · <%= Html.esc(h.get("accion")) %></strong> · <%= Html.esc(h.get("creado_en")) %></p><p><%= Html.esc(h.get("actor")) %>: <%= Html.esc(h.get("estado_anterior")==null?"—":h.get("estado_anterior")) %> → <%= Html.esc(h.get("estado_nuevo")) %> · Responsable: <%= Html.esc(h.get("responsable")) %></p><p class="whitespace-pre-wrap break-words text-stone-600"><%= Html.esc(h.get("comentario")) %></p></div><% } %></div></section>
<script>(function(){const url=<%= "\""+ctx+"/monitor/estado?tienda="+tiendaId+"\"" %>;async function cargar(){try{const r=await fetch(url,{credentials:'same-origin',cache:'no-store'});if(!r.ok)throw new Error('HTTP '+r.status);const d=await r.json();document.getElementById('inc-requests').textContent=d.solicitudes;document.getElementById('inc-errores').textContent=d.errores;document.getElementById('inc-tiempo').textContent=d.promedioMs+' ms';document.getElementById('inc-monitor-status').textContent='Activo';}catch(e){document.getElementById('inc-monitor-status').textContent='No disponible';}}cargar();setInterval(()=>{if(!document.hidden)cargar()},10000);})();</script>
<%@ include file="/WEB-INF/jspf/admin-fin.jspf" %></html>
