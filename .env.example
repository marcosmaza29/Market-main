# Copia este archivo como ".env" y pon tus datos reales de Supabase (Connect → Session pooler).
# Si la clave tiene caracteres especiales: @ → %40, # → %23, / → %2F
DATABASE_URL=postgresql://postgres.TU_REF:TU_CLAVE@aws-0-TU_REGION.pooler.supabase.com:5432/postgres
# Opcional: genera secretos aleatorios, no reutilices tu contraseña de Supabase.
# METRICS_TOKEN debe tener al menos 24 caracteres.
METRICS_TOKEN=REEMPLAZAR_POR_SECRETO_ALEATORIO_DE_48_CARACTERES
GRAFANA_USER=admin
GRAFANA_PASSWORD=REEMPLAZAR_POR_CONTRASENA_SEGURA
